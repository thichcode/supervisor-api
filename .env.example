# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supervisor_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_INPUT_SECRET=your_webhook_secret_here
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xxx.logic.azure.com:443/workflows/xxx
WEBHOOK_TIMEOUT=30

# ============================================
# LLM Provider Configuration
# ============================================
# Supported providers: ollama, openai, azure
# Default: ollama (self-hosted, Vietnamese-optimized)
LLM_PROVIDER=ollama

# Model name (used with all providers)
LLM_MODEL=llama3

# Ollama/llama.cpp Configuration
# Use http://host.docker.internal:8080 for Docker on Mac/Windows
# Use http://llama-cpp:8080 for Docker Compose with llama-cpp service
OLLAMA_BASE_URL=http://localhost:8080
OLLAMA_TIMEOUT=320

# OpenAI Configuration (optional - leave empty to use Ollama)
OPENAI_API_KEY=

# Azure OpenAI Configuration (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_DEPLOYMENT_NAME=

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================
# Agent Configuration
# ============================================
AGENT_TIMEOUT=10
AGENT_RETRY=1

# ============================================
# Memory Configuration
# ============================================
MEMORY_CONVERSATION_TTL=86400
MEMORY_SUMMARY_TTL=604800

# MemPalace External Memory (optional)
# MEMPALACE_ENABLED=false
# MEMPALACE_PATH=
# MEMPALACE_TOP_K=3

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Application Settings
# ============================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Circuit Breaker (optional)
# ============================================
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
# CIRCUIT_BREAKER_TIMEOUT=30

# ============================================
# Observability (optional)
# ============================================
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=supervisor-api

# ============================================
# Grafana (optional)
# ============================================
# GRAFANA_ADMIN=admin

# ============================================
# Extended Tools (disabled by default)
# ============================================
# File Processor - Process PDF/Excel/CSV attachments
ENABLE_FILE_PROCESSOR=true

# RAG Pipeline - Hybrid search for knowledge base
ENABLE_RAG_PIPELINE=false

# Scheduler - Cron jobs for automation
ENABLE_SCHEDULER=false

# API Client - External API integrations
ENABLE_API_CLIENT=false

# Audit Logger - Compliance logging
ENABLE_AUDIT_LOGGER=false

# Validators - Input validation
ENABLE_VALIDATORS=false

# Notification - Multi-channel notifications (auto-enabled if any config set)
ENABLE_NOTIFICATION=false
