DB_PASSWORD=your_postgres_password
REDIS_PASSWORD=your_redis_password
WEBHOOK_INPUT_SECRET=your_webhook_secret
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xxx.logic.azure.com:443/workflows/xxx

# LLM Provider Configuration
# Default: Ollama (self-hosted, Vietnamese-optimized)
OPENAI_API_KEY=  # Optional: Leave empty to use Ollama

# Model Configuration
LLM_MODEL=llama3  # Options: llama3, phi3, mistral, qwen2, mixtral
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Ollama Configuration (for self-hosted Vietnamese models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_TIMEOUT=120

# Azure OpenAI (optional fallback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_DEPLOYMENT_NAME=

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supervisor_db
DB_USER=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10

WEBHOOK_TIMEOUT=30
AGENT_TIMEOUT=10
AGENT_RETRY=1

MEMORY_CONVERSATION_TTL=86400
MEMORY_SUMMARY_TTL=604800

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

LOG_LEVEL=INFO
