# ============================================
# Database (Extended)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supervisor_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================
# Redis (Extended)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_INPUT_SECRET=your_webhook_secret_here
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xxx.logic.azure.com:443/workflows/xxx
WEBHOOK_TIMEOUT=30

# ============================================
# LLM Provider Configuration
# ============================================
# Supported providers: ollama, openai, azure (auto-detect if empty)
# Default: ollama (self-hosted, Vietnamese-optimized)
LLM_PROVIDER=ollama

# Model name (used with all providers)
LLM_MODEL=llama3

# Ollama/llama.cpp Configuration
# Use http://host.docker.internal:8088 for Docker on Mac/Windows
# Use http://llama-cpp:8088 for Docker Compose with llama-cpp service
OLLAMA_BASE_URL=http://localhost:8088
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_TIMEOUT=320
EXTRA_HOSTS=host.docker.internal:host-gateway
LLM_HEALTHCHECK_ENABLED=false

# OpenAI Configuration (optional - leave empty to use Ollama)
OPENAI_API_KEY=

# Azure OpenAI Configuration (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_DEPLOYMENT_NAME=

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================
# Agent Configuration
# ============================================
AGENT_TIMEOUT=10
AGENT_RETRY=1

# ============================================
# Memory Configuration
# ============================================
MEMORY_CONVERSATION_TTL=86400
MEMORY_SUMMARY_TTL=604800
ENABLE_USER_STYLE_LEARNING=true
USER_STYLE_LEARNING_USER_ID=
USER_STYLE_LEARNING_USER_IDS=

# MemPalace External Memory (optional)
# MEMPALACE_ENABLED=false
# MEMPALACE_PATH=
# MEMPALACE_TOP_K=3

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Application Settings
# ============================================
APP_NAME=Multi-Agent Supervisor System
APP_VERSION=1.2.3
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Circuit Breaker (optional)
# ============================================
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
# CIRCUIT_BREAKER_TIMEOUT=30

# ============================================
# Observability (optional)
# ============================================
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=supervisor-api

# ============================================
# Grafana (optional)
# ============================================
# GRAFANA_ADMIN=admin

# ============================================
# n8n Integration
# ============================================
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ============================================
# Notification (auto-enabled if configured)
# ============================================
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_TEAMS_ENABLED=true
NOTIFICATION_WEBHOOK_URL=

# SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# MS Teams webhook
TEAMS_WEBHOOK_URL=

# ============================================
# Telegram Approval Notifications
# Telegram Approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_IDS=
TELEGRAM_PARSE_MODE=Markdown

# Optional outbound proxy for Telegram/API egress
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
http_proxy=
https_proxy=
all_proxy=
no_proxy=localhost,127.0.0.1,::1

# ============================================
# Scheduler
# ============================================
SCHEDULER_ENABLED=false
SCHEDULER_CRON_DEFAULT=0 9 * * *

# ============================================
# v2 Enhancements (enabled by default)
# ============================================
ENABLE_BM25_SEARCH=true
ENABLE_BAYESIAN_CONFIDENCE=true
ENABLE_LRU_CACHE=true
ENABLE_AGENT_ROUTER=true
ENABLE_URL_FETCHER=true
ENABLE_TOOLS=true

# ============================================
# Extended Tools (disabled by default)
# ============================================
ENABLE_RAG_PIPELINE=false
ENABLE_FILE_PROCESSOR=true
ENABLE_SCHEDULER=false
ENABLE_API_CLIENT=false
ENABLE_AUDIT_LOGGER=false
ENABLE_VALIDATORS=false
ENABLE_NOTIFICATION=false
