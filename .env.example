DB_PASSWORD=your_postgres_password
REDIS_PASSWORD=your_redis_password
WEBHOOK_INPUT_SECRET=your_webhook_secret
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xxx.logic.azure.com:443/workflows/xxx

OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supervisor_db
DB_USER=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10

WEBHOOK_TIMEOUT=30
AGENT_TIMEOUT=10
AGENT_RETRY=1

MEMORY_CONVERSATION_TTL=86400
MEMORY_SUMMARY_TTL=604800

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

LOG_LEVEL=INFO
