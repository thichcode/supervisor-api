# Production environment template for supervisor-api
# Copy this file to .env.production on the server, then fill real secrets.

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=supervisor_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=10

# Webhook
WEBHOOK_INPUT_SECRET=***
JWT_SECRET=***
HMAC_SECRET=***
API_KEYS=***
POWER_AUTOMATE_WEBHOOK_URL=
WEBHOOK_TIMEOUT=30

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://host.docker.internal:8088
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_TIMEOUT=320
OLLAMA_IMAGE_MODEL=llama3.1-vision
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
EXTRA_HOSTS=host.docker.internal:host-gateway
LLM_HEALTHCHECK_ENABLED=false

# Optional AI providers
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_DEPLOYMENT_NAME=

# App
APP_NAME=Multi-Agent Supervisor System
APP_VERSION=1.2.3
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=2
APP_ENV=production
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# Agent
AGENT_TIMEOUT=10
AGENT_RETRY=1

# v2 Enhancements
ENABLE_BM25_SEARCH=true
ENABLE_BAYESIAN_CONFIDENCE=true
ENABLE_LRU_CACHE=true
ENABLE_AGENT_ROUTER=true
ENABLE_URL_FETCHER=true
ENABLE_TOOLS=true
ENABLE_REASONING_LOOP=false
REASONING_LOOP_MAX_ITERATIONS=3
REASONING_LOOP_TOOL_RETRY=1
ENABLE_LLM_TOOL_PLANNING=false
REASONING_LOOP_ROLLOUT_USER_PERCENT=100
REASONING_LOOP_ROLLOUT_TEAM_PERCENT=100
REASONING_LOOP_ROLLOUT_SALT=reasoning-loop-v1

# Extended tools
ENABLE_RAG_PIPELINE=false
ENABLE_FILE_PROCESSOR=true
ENABLE_SCHEDULER=false
ENABLE_API_CLIENT=false
ENABLE_AUDIT_LOGGER=false
ENABLE_VALIDATORS=false
ENABLE_NOTIFICATION=false
ENABLE_FACT_STORE=true
ENABLE_SUBAGENT_DELEGATION=true

# Memory
MEMORY_CONVERSATION_TTL=86400
MEMORY_SUMMARY_TTL=604800
MEMORY_MAX_TOKENS=4000
ENABLE_USER_STYLE_LEARNING=true
USER_STYLE_LEARNING_USER_ID=
USER_STYLE_LEARNING_USER_IDS=

# MemPalace External Memory (optional)
MEMPALACE_ENABLED=false
MEMPALACE_PATH=
MEMPALACE_TOP_K=3
MEMPALACE_TIMEOUT_SECONDS=2.0
MEMPALACE_RETRY_ATTEMPTS=2
MEMPALACE_CIRCUIT_FAILURE_THRESHOLD=3
MEMPALACE_CIRCUIT_SUCCESS_THRESHOLD=2
MEMPALACE_CIRCUIT_TIMEOUT_SECONDS=30.0

# File-based Memory (optional)
FILE_MEMORY_ENABLED=false
FILE_MEMORY_PATH=

# Monitoring
GRAFANA_ADMIN=admin

# n8n
# Dùng http://host.docker.internal:5678 khi supervisor chạy trong Docker container
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_TEAMS_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
TEAMS_WEBHOOK_URL=

# Telegram (for approval)
TELEGRAM_BOT_TOKEN=***
TELEGRAM_APPROVAL_CHAT_IDS=xxx
TELEGRAM_PARSE_MODE=Markdown
APPROVAL_NOTIFICATION_COOLDOWN_SECONDS=0

# Optional outbound proxy for Telegram/API egress
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
http_proxy=
https_proxy=
all_proxy=
no_proxy=localhost,127.0.0.1,::1

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_CRON_DEFAULT=0 9 * * *
